{
    // 使用 IntelliSense 了解相关属性。 
    // 悬停以查看现有属性的描述。
    // 欲了解更多信息，请访问: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "(gdb) Launch",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/bin/debug/BoxPusher.exe", // 必须与 tasks.json 的输出一致
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}/bin/debug/",
      "environment": [],
      "externalConsole": false, // 如果你想在新控制台打开，改为 true
      "MIMode": "gdb",
      "miDebuggerPath": "E:\\Environments\\MinGW\\mingw32\\bin\\gdb.exe", // 你的 GDB 路径
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ],
      "preLaunchTask": "debug" // 必须与 tasks.json 的 label 一致！
    }
  ]
}